{
  "name": "try-cloudflare-gui",
  "version": "1.1.2",
  "description": "GUI application for managing Try Cloudflare tunnels",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && electron .",
    "build": "vite build && tsc -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:electron": "bun run build && electron-builder",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [],
  "author": "Nergis",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.32.0",
    "@types/tar": "^7.0.87",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "pretendard-gov": "^1.3.9",
    "pretendard-jp": "^1.3.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "tar": "^7.5.15"
  },
  "build": {
    "appId": "dev.nergis.trycloudflaregui",
    "productName": "TryCloudflare GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "*.png",
          "*.ico"
        ]
      }
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
